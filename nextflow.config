params {
    // Inputs and Outputs
    input          = null
    outdir         = 'results'
    
    // Tool-specific parameters
    min_gene_mean  = 0.0
    method         = 'cosine'
    sample_cols    = 'auto'
}

process {
    // Specific configuration for the COMPUTE_COSINE module
    withName: COMPUTE_COSINE {
        // We inject the arguments here to keep the module clean and reusable
        ext.args = [
            "--method ${params.method}",
            "--min_gene_mean ${params.min_gene_mean}",
            "--sample_cols ${params.sample_cols}"
        ].join(' ').trim()
        
        // Publish directory (where results are saved)
        publishDir = [
            path: { "${params.outdir}/cosine_similarity" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Profile definitions
profiles {
    docker {
        docker.enabled = true
        // Fix for Linux users to avoid permission issues with mounted volumes
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    conda {
        conda.enabled = true
    }
    test {
        // Basic test profile for quick debugging
        params.input = 'data/test_expression.csv'
        params.method = 'pearson'
    }
}
